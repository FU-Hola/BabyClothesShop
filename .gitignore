# Repository policy: keep source, lockfiles, migrations, shared configuration,
# sanitized examples and application assets. Ignore generated/local state only.
# Ignore rules do not remove files that Git already tracks.

# Dependencies and package-manager caches (React / Vite / Node.js)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Frontend build output and tooling caches
/frontend/dist/
/frontend/dist-ssr/
/frontend/build/
.vite/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Test / coverage / browser automation output
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Logs, process files and temporary output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
*.tmp
*.temp
*.swp
*.swo
*~
/tmp/
/temp/

# Environment and credentials — commit sanitized templates only
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
.aws/
.ssh/
secrets/
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ecdsa
id_ed25519
.npmrc.local

# Spring Boot / Maven (including nested backend projects)
/backend/**/target/
*.class
hs_err_pid*
replay_pid*
*.hprof
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml
/backend/**/application-local.properties
/backend/**/application-local.yml
/backend/**/application-local.yaml
/backend/**/application-secrets.properties
/backend/**/application-secrets.yml
/backend/**/application-secrets.yaml
# Keep Maven wrapper scripts, properties and wrapper JAR for reproducible builds.
# Keep application.yaml and profile configs; only local/secrets overrides are ignored.

# Runtime storage / database dumps; keep SQL migrations and mock fixtures
/backend/**/data/
/backend/**/uploads/
/backend/**/storage/
/backend/**/backups/
/backend/**/dumps/
/docker/volumes/
/frontend/uploads/
/backups/
/dumps/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.h2.db
*.mv.db
*.trace.db

# IDE state — only reviewed, shareable VS Code recommendations are allowed
.idea/
*.iws
*.iml
*.ipr
**/.vscode/*
!**/.vscode/extensions.json
.vs/
*.suo
*.user
/backend/**/.apt_generated/
/backend/**/.classpath
/backend/**/.factorypath
/backend/**/.project
/backend/**/.settings/
/backend/**/.springBeans
/backend/**/.sts4-cache/

# Local AI tooling, indexes and generated UI inspection artifacts
# Existing project policy: these assistant settings remain local.
.cursor/
.codex/
.agents/
.claude/
.codegraph/
AGENTS.md
AGENTS.override.md
CLAUDE.md

# Local project documentation
/docs/

# Python cache produced by local tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
