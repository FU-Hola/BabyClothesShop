# Java properties syntax: KEY=value, no export or surrounding quotes.
# Copy to .env; replace every CHANGE_ME. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=sba_project
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
DB_MIGRATION_USERNAME=baby_clothes_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME
# Schema changes are managed by Flyway; Hibernate always validates.
DB_SSL_MODE=disable
SERVER_PORT=8080
JWT_SECRET_BASE64=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=baby-clothes-shop-api
JWT_AUDIENCE=baby-clothes-shop
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_LINK_TTL_MINUTES=30

# SMTP. Local development can use Mailpit/MailHog on port 1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@babyclothesshop.local
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false

# Docker-only PostgreSQL administrator password.
POSTGRES_PASSWORD=CHANGE_ME

# Unpaid checkout reservation lifetime and expiry scan interval.
CHECKOUT_HOLD_SECONDS=600
CHECKOUT_EXPIRY_SCAN_MS=15000
