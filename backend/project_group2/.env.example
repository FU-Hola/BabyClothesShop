# Java properties syntax: KEY=value, no export or surrounding quotes.
# Copy to .env; replace every CHANGE_ME. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=sba_project
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
DB_MIGRATION_USERNAME=baby_clothes_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=local-admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Docker-only PostgreSQL administrator password.
POSTGRES_PASSWORD=CHANGE_ME
